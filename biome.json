{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": { "includes": ["src/**", "tests/**", "examples/**", "e2e/*.ts", "*.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "useTemplate": "off", "noParameterAssign": "off" },
      "suspicious": { "noExplicitAny": "off", "noAssignInExpressions": "off", "noConfusingVoidType": "off" },
      "complexity": { "noStaticOnlyClass": "off" }
    }
  }
}
