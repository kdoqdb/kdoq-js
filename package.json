{
  "name": "@kdoq/kdoq",
  "version": "0.0.1-rc.1",
  "description": "JavaScript client for the kdoq document database (native protocol over WebTransport)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./value": {
      "types": "./dist/value/index.d.ts",
      "default": "./dist/value/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test tests",
    "test:e2e": "bun e2e/run-bun.ts",
    "test:e2e:browser": "python3 e2e/run.py"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@fails-components/webtransport": "^1.6.11",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.11",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "trustedDependencies": [
    "@fails-components/webtransport-transport-http3-quiche"
  ]
}
